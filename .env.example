# Copy this file to ".env" and fill in your key.
# Get a key at https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional overrides (sensible defaults are built in) ---

# Model that writes answers. Default is the most capable model.
# To cut cost for a public bot, switch to claude-sonnet-4-6 or claude-haiku-4-5.
# ANSWER_MODEL=claude-opus-4-8

# Cheap classifier that blocks off-topic messages before they cost answer-model tokens.
# GATE_MODEL=claude-haiku-4-5

# PORT=3000

# --- Abuse / token guardrails ---
# MAX_INPUT_CHARS=1200          # max characters per user message
# MAX_HISTORY_TURNS=8           # messages of history kept (4 exchanges)
# MAX_HISTORY_CHARS=8000        # total history characters sent to the model
# MAX_OUTPUT_TOKENS=1024        # cap on answer length

# RL_WINDOW_MS=300000           # rate-limit window (5 min)
# RL_MAX_PER_WINDOW=20          # max requests per IP per window
# RL_MAX_PER_DAY=150            # max requests per IP per day
# GLOBAL_DAILY_BUDGET=3000      # total requests/day across all users (circuit breaker)
GOOGLE_MAPS_API_KEY=       # optional: enables Google Places search + live-traffic ETAs for /awty
